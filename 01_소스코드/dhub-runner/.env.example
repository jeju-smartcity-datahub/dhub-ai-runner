# Copy to .env. Only the runner's own infrastructure is configured here.
# Secrets of pipelines and agents (API keys, LLM endpoints, ...) are never passed
# as environment variables: enter them in the web UI (시크릿) or with
# `dhub-runner secret set <secret>/<key>`.

# RustFS (S3-compatible storage for collections and tables).
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin

# Postgres (the secret store and the dataset catalog).
POSTGRES_PASSWORD=runner

# Key that encrypts stored secrets (a Fernet key). Generate one with
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Without it the runner generates one into the data volume (<data>/secret.key);
# losing that key makes the stored secrets unreadable.
RUNNER_SECRET_KEY=

# headless profile only: the local collection collection-init uploads to RustFS, and the name it gets
# there (s3://dhub-runner/collections/<COLLECTION_NAME>; also the collection whose secrets it reads).
COLLECTION_DIR=./examples/quickstart
COLLECTION_NAME=quickstart

RUNNER_LOG_LEVEL=INFO
